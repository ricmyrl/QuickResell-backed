generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  REMOVED
}

enum AuctionRoomStatus {
  ACTIVE
  PENDING_APPROVAL
  SOLD
  REJECTED
  CLOSED
}

enum PurchaseOrderStatus {
  PENDING_HANDOFF
  COMPLETED
  CANCELLED
}

enum OrderItemFulfillmentStatus {
  PENDING_HANDOFF
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
}

enum FulfillmentMethod {
  PICKUP
  SHIPPING
}

enum MessageType {
  GENERAL
  REVIEW
  REPLY
}

enum NotificationType {
  BID_PLACED
  OUTBID
  AUCTION_WON
  AUCTION_CLOSED
  PRICE_UPDATED
  LISTING_SOLD
  REVIEW
  REPLY
  ORDER_UPDATE
}

enum ListingReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

model User {
  id                    String         @id @db.Uuid
  email                 String?        @unique
  displayName           String?
  avatarUrl             String?
  isCampusVerified      Boolean        @default(false)
  preferredDormOrCampus String?
  budgetPreference      Float?
  trustScore            Float          @default(50.0)
  completedAuctions     Int            @default(0)
  backedOutAuctions     Int            @default(0)
  savedCategories       String[]       @default([])
  embedding             Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  posts                 Post[]
  productComments      ProductComment[]
  productCommentReactions ProductCommentReaction[]
  listingReactions     ListingReaction[]
  buyerConversations    Conversation[] @relation("ConversationBuyer")
  sellerConversations   Conversation[] @relation("ConversationSeller")
  sentMessages          Message[]
  notifications         Notification[]
  sellerAuctionRooms    AuctionRoom[]  @relation("AuctionSeller")
  wonAuctionRooms       AuctionRoom[]  @relation("AuctionWinner")
  bids                  Bid[]
  cartItems             CartItem[]
  watchlistItems        WatchlistItem[]
  auctionWatchlistItems AuctionWatchlistItem[]
  scoutFeedback        ScoutFeedback[]
  supportRequests      SupportRequest[]
  purchaseOrders        PurchaseOrder[]
  soldOrderItems         PurchaseOrderItem[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id             String         @id @default(cuid())
  sellerId       String         @db.Uuid
  categoryId     String
  title          String
  description    String?
  price          Float
  originalPrice  Float?
  locationCampus String?
  latitude       Float?
  longitude      Float?
  embedding      Json?
  status         ListingStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ListingImage[]
  conversations  Conversation[]
  auctionRoom    AuctionRoom?
  quantityAvailable Int             @default(1)
  cartItems      CartItem[]
  watchlistItems WatchlistItem[]
  purchaseOrderItems PurchaseOrderItem[]
  comments       ProductComment[]
  listingReactions ListingReaction[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([sellerId, status])
}

model ProductComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String   @db.Uuid
  parentId  String?
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ProductComment? @relation("ProductCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProductComment[] @relation("ProductCommentReplies")
  reactions ProductCommentReaction[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
}

model ProductCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String   @db.Uuid
  type      String   @default("LIKE")
  createdAt DateTime @default(now())
  comment   ProductComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

model ListingReaction {
  id        String              @id @default(cuid())
  postId    String
  userId    String              @db.Uuid
  type      ListingReactionType
  createdAt DateTime            @default(now())
  post      Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId, createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  postId    String
  url       String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String?
  buyerId   String    @db.Uuid
  sellerId  String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listing   Post?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer     User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String       @db.Uuid
  content        String       @db.Text
  type           MessageType  @default(GENERAL)
  rating         Int?
  replyToId      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([conversationId, type])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String           @db.Uuid
  type          NotificationType
  title         String
  message       String           @db.Text
  entityType    String?
  entityId      String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
}

model AuctionRoom {
  id                String            @id @default(cuid())
  postId            String            @unique
  sellerId          String            @db.Uuid
  currentHighestBid Float
  highestBidderId   String?           @db.Uuid
  isPublic          Boolean           @default(false)
  reservePrice      Float?
  status            AuctionRoomStatus @default(ACTIVE)
  endsAt            DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  post              Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  seller            User              @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  highestBidder     User?             @relation("AuctionWinner", fields: [highestBidderId], references: [id], onDelete: SetNull)
  bids              Bid[]
  watchlistItems    AuctionWatchlistItem[]
  cartItems         CartItem[]

  @@index([status, endsAt])
  @@index([isPublic, status, endsAt])
  @@index([sellerId, createdAt])
}

model Bid {
  id            String      @id @default(cuid())
  auctionRoomId String
  bidderId      String      @db.Uuid
  amount        Float
  createdAt     DateTime    @default(now())
  auctionRoom   AuctionRoom @relation(fields: [auctionRoomId], references: [id], onDelete: Cascade)
  bidder        User        @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionRoomId, createdAt])
  @@index([bidderId, createdAt])
}

model CartItem {
  id            String      @id @default(cuid())
  userId        String      @db.Uuid
  postId        String
  auctionRoomId String?
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  auctionRoom   AuctionRoom? @relation(fields: [auctionRoomId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([auctionRoomId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model AuctionWatchlistItem {
  id             String      @id @default(cuid())
  userId         String      @db.Uuid
  auctionRoomId  String
  maxBid         Float
  bidStep        Float       @default(1)
  autoBidEnabled Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionRoom    AuctionRoom @relation(fields: [auctionRoomId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionRoomId])
  @@index([autoBidEnabled, updatedAt])
}

model ScoutFeedback {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  messageId String
  intent    String?
  helpful   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([intent, helpful, createdAt])
}

model SupportRequest {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  category  String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrder {
  id               String               @id @default(cuid())
  buyerId          String               @db.Uuid
  paymentReference String?              @unique
  status           PurchaseOrderStatus  @default(PENDING_HANDOFF)
  subtotalCents    Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  buyer            User                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  postId         String
  sellerId       String        @db.Uuid
  title          String
  quantity       Int
  unitPriceCents Int
  fulfillmentStatus OrderItemFulfillmentStatus @default(PENDING_HANDOFF)
  fulfillmentMethod FulfillmentMethod?
  createdAt      DateTime      @default(now())
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  post           Post          @relation(fields: [postId], references: [id], onDelete: Restrict)
  seller         User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([postId])
}
